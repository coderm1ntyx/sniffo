{
  "name": "sniffo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @sniffo/api",
    "dev:web": "npm run dev -w @sniffo/web",
    "build": "npm run build -w @sniffo/shared && npm run build -w @sniffo/api && npm run build -w @sniffo/web",
    "test": "npm run test -w @sniffo/shared && npm run test -w @sniffo/api && npm run test -w @sniffo/web",
    "typecheck": "npm run build -w @sniffo/shared && npm run typecheck -w @sniffo/api && npm run typecheck -w @sniffo/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark:verification": "tsx apps/api/scripts/benchmark-verification.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
