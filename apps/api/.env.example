# Local development defaults for Sniffo. Optional provider integrations are off.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# Optional server-side providers. Keep credentials out of VITE_* variables.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# GOOGLE_CLOUD_VISION_API_KEY=

# Optional narration; disabled unless explicitly enabled.
ELEVENLABS_TTS_ENABLED=false
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_MAX_CHARS_PER_REQUEST=400
ELEVENLABS_APP_MONTHLY_CHAR_BUDGET=3000
ELEVENLABS_TTS_TIMEOUT_MS=12000
ELEVENLABS_MAX_AUDIO_BYTES=1000000

# Local runs generate an ephemeral signing key when this is unset.
# Production mode requires a private random value of at least 32 characters.
# EVIDENCE_SIGNING_SECRET=

# Research is optional and disabled by default to avoid unexpected provider use.
DEEP_RESEARCH_ENABLED=false
DEEP_RESEARCH_SEARCH_PROVIDER=none
DEEP_RESEARCH_OPENAI_WEB_SEARCH_ENABLED=false
# DEEP_RESEARCH_SEARCH_URL=
DEEP_RESEARCH_MAX_QUERIES=2
DEEP_RESEARCH_MAX_CANDIDATES=3
DEEP_RESEARCH_TIMEOUT_MS=20000
DEEP_RESEARCH_CANDIDATE_TIMEOUT_MS=4000
DEEP_RESEARCH_OPENAI_SEARCH_TIMEOUT_MS=8000
DEEP_RESEARCH_CONCURRENCY=2
DEEP_RESEARCH_MAX_ACTIVE=2
DEEP_RESEARCH_VISION_ENABLED=false
DEEP_RESEARCH_VISION_MODEL=gpt-4.1-mini
DEEP_RESEARCH_MAX_VISION_CALLS=1
DEEP_RESEARCH_MAX_ORIGINAL_IMAGES=2
DEEP_RESEARCH_MAX_CANDIDATE_IMAGES=2
DEEP_RESEARCH_VISION_MAX_OUTPUT_TOKENS=300
DEEP_RESEARCH_VISION_MAX_DIMENSION=1024
DEEP_RESEARCH_VISION_TIMEOUT_MS=6000
DEEP_RESEARCH_LOCAL_VISION_BUDGET_USD=1.00
DEEP_RESEARCH_VISION_RESERVATION_USD=0.05
